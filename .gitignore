# NeuralCard — what stays out of the repo.
#
# Rule of thumb: commit the SOURCE (schematic, board, custom libraries, and the
# scripts that generate them) plus the RELEASED fab package. Ignore anything a
# tool rewrites on its own, anything KiCad writes per-user, and anything that
# can be regenerated from the sources above.
#
# Baseline follows github/gitignore's KiCad.gitignore:
# https://github.com/github/gitignore/blob/main/KiCad.gitignore

# ---------------------------------------------------------------- KiCad backups
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_sym-bak
*-save.pro
*-save.kicad_pcb
*.000
_autosave-*
*-backups/
**/*-backups/*.zip
*.lck

# ---------------------------------------------------- KiCad local / per-user state
# Board-independent UI state. Differs per machine, causes pointless diffs.
*.kicad_prl
fp-info-cache
.history/

# --------------------------------------------------------- KiCad generated output
# All regenerated by the pipeline documented in README; never hand-edited.
*.erc
*.net
*-cache.lib
*-rescue.lib
NeuralCard.dsn
NeuralCard.ses

# Note: the fab/*.csv BOMs ARE tracked on purpose. They are release
# deliverables uploaded to the fab, not incidental KiCad exports.

# --------------------------------------------------------------- heavy / derivable
*.blend
*.blend1
*.glb
*.stp
# Exported/scratch STEP stays out; the footprint 3D libraries are part of the
# design and must clone with it - every ${KIPRJMOD} model path depends on them.
*.step
!**/*.3dshapes/*.step
!**/*.3dshapes/*.wrl
datasheets/

# ------------------------------------------------------------- superseded fab runs
# Keep only the current fab/ bundle; dated snapshots live in git history.
fab.old-*/
fab.bak*/

# ---------------------------------------------------------------- local-only
/hardware/*.py
/hardware/tools/*

# ------------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------- editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*~

# ------------------------------------------------------------------ firmware
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old

# ------------------------------------------------- never commit (privacy)
# Local environment leaks: absolute paths and machine notes belong nowhere
# in this repo. See CLAUDE.md. 3D models must use ${KIPRJMOD}.
*.local
.env
.DS_Store
# Generator scripts live in the private tools repo, never here.
/hardware/*.py
/tools/

# ------------------------------------------------- tool binaries
hardware/tools/freerouting.jar
