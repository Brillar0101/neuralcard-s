(module easyeda2kicad:LED-SMD_L1.6-W0.8-R-RD (layer F.Cu) (tedit 5DC5F6A4)
	(descr "0603 red LED, KENTO KT-0603R rev A.0. Body 1.60x0.80x0.60 mm. Land pattern per datasheet section 2 (0.70x0.70 pads, 0.70 gap, span 2.10). Pin 1 = anode (+), pin 2 = cathode (silk bracket).")
	(tags "LED 0603 KT-0603R")
	(attr smd)
	(fp_text reference REF** (at 0.000 -4.000) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value LED-SMD_L1.6-W0.8-R-RD (at 0.000 4.000) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "LCSC Part" "C2286")
	(fp_line (start -1.30 -0.60) (end 0.55 -0.60) (layer F.SilkS) (width 0.15))
	(fp_line (start -1.30 0.60) (end 0.55 0.60) (layer F.SilkS) (width 0.15))
	(fp_line (start -1.30 -0.60) (end -1.30 0.60) (layer F.SilkS) (width 0.15))
	(fp_line (start -0.80 -0.40) (end 0.80 -0.40) (layer F.Fab) (width 0.1))
	(fp_line (start 0.80 -0.40) (end 0.80 0.40) (layer F.Fab) (width 0.1))
	(fp_line (start 0.80 0.40) (end -0.80 0.40) (layer F.Fab) (width 0.1))
	(fp_line (start -0.80 0.40) (end -0.80 -0.40) (layer F.Fab) (width 0.1))
	(fp_line (start 0.30 -0.25) (end 0.30 0.25) (layer F.Fab) (width 0.1))
	(fp_line (start 0.30 0.25) (end -0.20 0.00) (layer F.Fab) (width 0.1))
	(fp_line (start -0.20 0.00) (end 0.30 -0.25) (layer F.Fab) (width 0.1))
	(fp_line (start -0.20 -0.25) (end -0.20 0.25) (layer F.Fab) (width 0.1))
	(pad 2 smd rect (at -0.70 0.00 0.00) (size 0.700 0.700) (layers F.Cu F.Paste F.Mask))
	(pad 1 smd rect (at 0.70 0.00 0.00) (size 0.700 0.700) (layers F.Cu F.Paste F.Mask))
	(fp_line (start -1.40 -0.70) (end 1.40 -0.70) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.40 -0.70) (end 1.40 0.70) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.40 0.70) (end -1.40 0.70) (layer F.CrtYd) (width 0.05))
	(fp_line (start -1.40 0.70) (end -1.40 -0.70) (layer F.CrtYd) (width 0.05))
	(model "${KIPRJMOD}/JLC.3dshapes/LED0603_L1.6-W0.8-H0.6.step"
		(offset (xyz 0.000 0.000 0.000))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
